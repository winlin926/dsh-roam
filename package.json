{
  "name": "dsh-roam",
  "version": "0.2.1",
  "description": "把电脑上的 DeepSeek Harness 会话漫游到手机：浏览器扫码即用，AI-HUB App 共用同一地址和配对码。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/winlin926/dsh-roam.git"
  },
  "homepage": "https://github.com/winlin926/dsh-roam#readme",
  "bugs": {
    "url": "https://github.com/winlin926/dsh-roam/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "author": {
    "name": "winlin926",
    "email": "l1240235604@163.com"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "keywords": [
    "dsh-plugin",
    "dsh-bundle",
    "dsh",
    "deepseek-harness",
    "roam",
    "phone",
    "mobile",
    "qr",
    "pairing",
    "remote",
    "手机扫码",
    "手机继续会话",
    "远程访问",
    "AI-HUB",
    "ai-hub"
  ],
  "files": [
    "lib/**/*.js",
    "assets",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "build": "pnpm clean && tsc -p tsconfig.json && node scripts/copy-browser-client.mjs",
    "test": "pnpm build && vitest run",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm test"
  },
  "dependencies": {
    "acme-client": "5.4.0",
    "dsh-mobile-plugin": "0.1.92",
    "qrcode": "1.5.4",
    "ws": "8.18.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-client-locale": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.1-rc.2"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  }
}
